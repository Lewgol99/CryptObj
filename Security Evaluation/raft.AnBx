Protocol: CryptObj AnB
 
Types:
  Agent C1,C2,C3;   # candidates
  Number Term, Last_log_index, Last_log_term, PrevLogIdx, PrevLogTerm, Commit_index, Command, Entries, Next_node_idx;   # variables - values change every round/entry, matches paper/repo convention
  Number trueV, falseV;    # boolean-like flag constants (renamed from true/false - those are reserved keywords in ProVerif and block verification)
  Number RequestId, Log_idx, Log_term;   # apply_command_response fields - opaque correlation id + commit position, no succ/pre relationship. RequestId2 mirrors C2's independent apply_command branch (see Command2 note below)
  Number Nonce,X;   # fresh and random value generated
  Number request_vote, response_vote, append_entries, next_node_idx, apply_command, apply_command_response;   # message-type tags, part of signed payload
  Function [Agent -> PublicKey] pk; # maps each Agent to the Public Key (Public Key used to encrypt messages)
  Function [Agent -> PublicKey] sk; # used by others verification of the Public Key used by Agent for Authentication
  Function [Number -> Number] pre,succ; # pre = number before 'n' and succ = number after 'n'
 
Equations: # algebraic relationship - applying succ and pre gets back where you started
succ(pre(X)) = X;
pre(succ(X)) = X;
 
Knowledge:
  C1: C1, C2, C3, pk, sk, pre, succ, inv(sk(C1)), inv(pk(C1)), trueV, falseV, request_vote, response_vote, append_entries, next_node_idx, apply_command, apply_command_response;
  C2: C1, C2, C3, pk, sk, pre, succ, inv(sk(C2)), inv(pk(C2)), trueV, falseV, request_vote, response_vote, append_entries, next_node_idx, apply_command, apply_command_response;
  C3: C1, C2, C3, pk, sk, pre, succ, inv(sk(C3)), inv(pk(C3)), trueV, falseV, request_vote, response_vote, append_entries, next_node_idx, apply_command, apply_command_response;
 
Actions:

# as166h-node002-C2 | [PAYLOAD] pre-sign structure: identity=(C2:45025,C1:45025,C3:45025) || data={'type': 'request_vote', 'term': 1, 'last_log_index': 1, 'last_log_term': 0}
C2 -> C1: {{C2, C1, C3, request_vote, Term, Last_log_index, Last_log_term}inv(sk(C2))}pk(C1)

